{
  "name": "accountantsfactory-portal-backend",
  "version": "1.0.0",
  "description": "Backend API for AccountantsFactory Client Portal",
  "main": "server.js",
  "scripts": {
    "start": "prisma generate && node server.js",
    "dev": "nodemon server.js",
    "postinstall": "prisma generate || true",
    "create-admin": "node scripts/createAdmin.js",
    "reset-admin-password": "node scripts/resetAdminPassword.js",
    "setup-database": "node scripts/setupDatabase.js",
    "setup-mongodb": "node scripts/setupMongoDB.js",
    "test-api": "node scripts/test-api.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --watch"
  },
  "keywords": [
    "accountantsfactory",
    "client-portal",
    "api"
  ],
  "author": "AccountantsFactory",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "file-type": "^18.7.0",
    "form-data": "^4.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.19.1",
    "nodemailer": "^7.0.12",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.5",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "verbose": true
  }
}
