# Netlify-style headers file (also read by some Zoho Catalyst deployments).
# Forces HTML to never be cached so JS version params are always respected.

/portal/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/*.html
  Cache-Control: public, max-age=300, must-revalidate

/portal/js/*
  Cache-Control: public, max-age=3600

/js/*
  Cache-Control: public, max-age=3600

/images/*
  Cache-Control: public, max-age=2592000
