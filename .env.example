# AccountantsFactory portal — example environment variables.
#
# Copy to .env (gitignored) for local development, OR set these in the Catalyst
# console for production. The validator at api/src/config/env.js (once wired
# in) enforces presence + basic format at boot — no silent fallbacks.
#
# See docs/SECRETS-AUDIT.md for the secret-rotation plan and what each value
# means.
#
# DO NOT COMMIT REAL SECRETS.

# Runtime
NODE_ENV=production

# JWT — sign with `openssl rand -hex 32`
JWT_SECRET=__GENERATE_64_HEX_CHARS__

# Catalyst project
CATALYST_PROJECT_ID=__YOUR_PROJECT_ID__

# Catalyst CLI client (1004.*) — from `catalyst client-id-show`
AF_CLIENT_ID=1004.__YOUR_CLI_CLIENT_ID__
AF_CLIENT_SECRET=__YOUR_CLI_CLIENT_SECRET__
AF_REFRESH_TOKEN=1004.__YOUR_CLI_REFRESH_TOKEN__

# Self Client (1000.*) — from Zoho API Console
ZOHO_CLIENT_ID=1000.__YOUR_SELF_CLIENT_ID__
ZOHO_CLIENT_SECRET=__YOUR_SELF_CLIENT_SECRET__
ZOHO_REFRESH_TOKEN=1000.__YOUR_SELF_CLIENT_REFRESH_TOKEN__

# Recovery endpoints (POST /api/__recover-token etc.)
RECOVERY_SECRET=__GENERATE_64_HEX_CHARS__

# Emergency admin login (works when Catalyst is down)
EMERGENCY_ADMIN_EMAIL=admin@example.com
EMERGENCY_ADMIN_PASSWORD=__STRONG_PASSWORD_MIN_16_CHARS__

# Zoho SMTP
SMTP_HOST=smtp.zoho.in
SMTP_USER=you@example.com
SMTP_PASSWORD=__APP_PASSWORD__
EMAIL_FROM=you@example.com

# Optional
FRONTEND_URL=https://accountantsfactory.com,https://www.accountantsfactory.com
ADMIN_ALERT_EMAIL=alerts@example.com
